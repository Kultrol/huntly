DATABASE_NAME=huntly
TEST_DATABASE_NAME=huntly_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Local Python uses Mac port 5433; Compose supplies db:5432 inside Docker.
# Use a URL-safe password, or URL-encode it when writing DATABASE_URL manually.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${DATABASE_NAME}
